{
	"name": "githubstats",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ tests/ vitest.workerd.config.ts",
		"fmt:check": "oxfmt --check src/ tests/ vitest.workerd.config.ts",
		"test": "pnpm test:unit && pnpm test:workerd",
		"test:unit": "vitest run",
		"test:workerd": "vitest run --config vitest.workerd.config.ts",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"harfbuzzjs": "0.10.3",
		"hono": "4.13.5",
		"satori": "0.33.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.1.3",
		"@fontsource/inter": "5.3.0",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.13.3",
		"@vitest/ui": "4.1.11",
		"jsdom": "30.0.1",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.128.0"
	}
}
