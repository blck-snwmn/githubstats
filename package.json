{
	"name": "githubstats",
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "cf dev",
		"deploy": "cf deploy --mode production",
		"cf-typegen": "cf workers types",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ tests/ vitest.workerd.config.ts cloudflare.config.ts wrangler.config.ts",
		"fmt:check": "oxfmt --check src/ tests/ vitest.workerd.config.ts cloudflare.config.ts wrangler.config.ts",
		"test": "pnpm test:unit && pnpm test:workerd",
		"test:unit": "vitest run",
		"test:workerd": "vitest run --config vitest.workerd.config.ts",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"harfbuzzjs": "0.10.3",
		"hono": "4.13.16",
		"satori": "0.35.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.12",
		"@testing-library/react": "16.3.3",
		"@types/node": "24.19.2",
		"@vitest/ui": "5.1.0",
		"cf": "1.0.0-beta.28",
		"jsdom": "30.1.3",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2006",
		"typescript": "7.0.2",
		"vitest": "5.1.0",
		"wrangler": "4.152.0"
	}
}
